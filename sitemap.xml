---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.html_pages | where_exp: 'node', 'node.sitemap != false' | where_exp: 'node', 'node.url != "/404.html"' | sort: 'url' %}
  {% for node in sitemap_pages %}
    {% for language in site.languages %}
      {% assign language_prefix = '' %}
      {% unless language == site.default_lang %}
        {% assign language_prefix = '/' | append: language %}
      {% endunless %}
      <url>
        <loc>{{ site.url | append: site.baseurl | append: language_prefix | append: node.url | xml_escape }}</loc>
      </url>
    {% endfor %}
  {% endfor %}
</urlset>
